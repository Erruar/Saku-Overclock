<Project Sdk="Microsoft.NET.Sdk">
    
    <Import Project="$(MSBuildThisFileDirectory)..\Saku Overclock\Version.props"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Saku Overclock\Version.props')" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>Saku_Overclock.Service</RootNamespace>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishSingleFile>true</PublishSingleFile>
        <ServiceVersion Condition="'$(ServiceVersion)' == ''">1.0.0.0</ServiceVersion>
        <AssemblyVersion>$(ServiceVersion)</AssemblyVersion>
        <FileVersion>$(ServiceVersion)</FileVersion>
        <Version>$(ServiceVersion)</Version>
        <SelfContained>true</SelfContained>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Speed</OptimizationPreference>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
        <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Saku Overclock.Core\Saku Overclock.Core\Saku Overclock.Core.csproj" />
    </ItemGroup>
</Project>