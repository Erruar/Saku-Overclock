  <Target Name="RemoveUnusedNativeDllsFromBin" AfterTargets="Build">
    <Delete Files="@(UnusedDlls->'$(TargetDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="RemoveUnusedNativeDllsFromPublish" AfterTargets="Publish">
    <Delete Files="@(UnusedDlls->'$(PublishDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="RemoveUnusedLanguageFolders" AfterTargets="Build" BeforeTargets="Pack">
    <ItemGroup>
      <_AllOutputDirs Include="$(OutputPath)*\" />

      <_KeepDirs Include="$(OutputPath)Assets\" />
      <_KeepDirs Include="$(OutputPath)en-us\" />
      <_KeepDirs Include="$(OutputPath)Microsoft.UI.Xaml\" />
      <_KeepDirs Include="$(OutputPath)Styles\" />
      <_KeepDirs Include="$(OutputPath)Views\" />

      <_LangDirsToRemove Include="@(_AllOutputDirs)"
                         Condition="
        $([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)',
          '^[a-z]{2,3}(-[A-Za-z]{2,4})*$'))
        And '%(FullPath)' != '$(OutputPath)en-us\'
      " />
    </ItemGroup>

    <RemoveDir Directories="@(_LangDirsToRemove)" />

    <Message Text="[LangDebloat] Удалено языковых папок: @(_LangDirsToRemove->Count())"
             Importance="high" />
    <Message Text="[LangDebloat] Список: @(_LangDirsToRemove)"
             Importance="normal" />
  </Target>

  <Target Name="PrepareSatelliteDependencies" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildingProject)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Saku Overclock.Shared\Saku Overclock.Shared\Saku Overclock.Shared.csproj"
             Properties="Configuration=$(Configuration);Platform=x64;TargetFramework=net10.0-windows" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ZenStates.Core\ZenStates-Core.csproj"
             Properties="Configuration=$(Configuration);Platform=x64;TargetFramework=net8.0-windows" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Saku Overclock.Core\Saku Overclock.Core\Saku Overclock.Core.csproj"
             Properties="Configuration=$(Configuration);Platform=x64;TargetFramework=net10.0-windows" />
  </Target>
  
  <Target Name="BuildServicePreBuild" DependsOnTargets="PrepareSatelliteDependencies" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildingProject)' == 'true'">
    <MSBuild Projects="$(_ServiceProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishAot=true;TargetFramework=net10.0-windows;PublishTrimmed=true;IsAotCompatible=true;PublishSingleFile=true"
             BuildInParallel="false" />
  </Target>

  <Target Name="BuildOverlayPreBuild" DependsOnTargets="BuildServicePreBuild" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildingProject)' == 'true'">
    <MSBuild Projects="$(_OverlayProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishAot=true;TargetFramework=net10.0-windows;PublishTrimmed=true;IsAotCompatible=true;PublishSingleFile=true"
             BuildInParallel="false" />
  </Target>

  <Target Name="IncludeSatellitesInOutput"
          DependsOnTargets="BuildOverlayPreBuild"
          BeforeTargets="GetCopyToOutputDirectoryItems;AssignTargetPaths">

    <ItemGroup>
      <Content Include="$(_ServicePublishExe)">
        <Link>Saku Overclock.Service.exe</Link> <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Content Include="$(_OverlayPublishExe)">
        <Link>Saku Overclock.Overlay.exe</Link> <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="CopySatellitesToPublishDir"
          AfterTargets="Publish">

    <Copy SourceFiles="$(_ServicePublishExe)"
          DestinationFiles="$(PublishDir)Saku Overclock.Service.exe"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_ServicePublishExe)')" />
    
    <Copy SourceFiles="$(_OverlayPublishExe)"
          DestinationFiles="$(PublishDir)Saku Overclock.Overlay.exe"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_OverlayPublishExe)')" />
  </Target>
