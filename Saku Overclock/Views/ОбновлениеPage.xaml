<?xml version="1.0" ?>
<Page
    x:Class="Saku_Overclock.Views.ОбновлениеPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Border x:Name="AccentTextBrush" Background="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        <Border x:Name="TextSecondaryBrush" Background="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Border x:Name="ControlStrongBrush" Background="{ThemeResource ControlStrongFillColorDefaultBrush}"/>
    </Page.Resources>

    <Grid Margin="-24,-55,-40,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1200">
        <Grid Background="{ThemeResource ControlStrokeColorDefaultBrush}"
              CornerRadius="24" Margin="30,-20,30,30"
              Width="450" HorizontalAlignment="Center" VerticalAlignment="Center"
              Shadow="{StaticResource SharedShadow}"
              Translation="0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="40,20,0,10">
                <StackPanel.Transitions>
                    <RepositionThemeTransition/>
                </StackPanel.Transitions>
                <FontIcon Glyph="&#xE895;" x:Name="UpdateIcon" Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                          FontWeight="Bold" FontSize="40" Margin="-37,20,0,0" />
                <TextBlock x:Uid="Update_New_Update" FontWeight="Semibold" FontSize="18"
                           Margin="18,12,0,0" x:Name="UpdateTitle" />
                <TextBlock Margin="18,6,0,0">
                    <Run Text="Saku Overclock"/>
                    <Run x:Name="UpdateVersion" Text="-"/>
                    <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="•"/>
                    <Run x:Name="UpdateType" Text="stable"/>
                </TextBlock>
                <TextBlock HorizontalAlignment="Left" Margin="18,7,0,0" FontSize="13" Width="350" TextAlignment="Left"
                           TextWrapping="WrapWholeWords" x:Uid="Update_New_SubTitle" x:Name="UpdateSubtitle"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <ProgressBar HorizontalAlignment="Center" Visibility="Collapsed" Width="331" x:Name="UpdatePercentBar" Margin="-40,8,0,0" Value="17"/>
            </StackPanel>
            <Grid Grid.Row="1" CornerRadius="10" Width="331" Background="{ThemeResource SmokeFillColorDefaultBrush}" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Vertical" Margin="2,0,2,0">
                        <Grid MinHeight="57">
                            <StackPanel Margin="13,12,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Orientation="Vertical" x:Name="MainChangelogContent"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <HyperlinkButton Grid.Row="1" Foreground="{ThemeResource SystemAccentColor}" Margin="2,0,0,0"
                                 Click="UpdateLearnAbout_OnClick" x:Uid="UpdateLearnMore" FontSize="12"
                                 Content="Узнать больше..." />
            </Grid>
            <Button Grid.Row="2" Width="331" CornerRadius="18"
                    Shadow="{StaticResource SharedShadow}"
                    Translation="0,0,10" x:Name="UpdateProceed"
                    x:Uid="Update_New_UpdateButton"
                    Click="Update_Click" Height="38"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{ThemeResource AccentButtonStyle}" />
            <Grid Grid.Row="3" Margin="0,-23,0,0">
                <Button Width="331" Height="38" CornerRadius="18"
                        x:Uid="Update_New_UpdateButton_Cancel" x:Name="UpdateCancel"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Background="Transparent"
                        Content="Продолжить использование"
                        Click="Cancel_Click" Shadow="{StaticResource SharedShadow}"
                        Translation="0,0,10" />
            </Grid>
        </Grid>
    </Grid>
</Page>